# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
DB_DIALECT=postgres
DB_HOST=db
DB_PORT=5432
DB_NAME=clinic_tracker
DB_USER=clinic_user
DB_PASS=changeme
DB_SSL=false

# ─── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://frontend:80

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Login endpoint: max attempts per window
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE=logs/app.log
